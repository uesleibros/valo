' Geometry shared by the game's entities.

' A point or a direction on the playfield.
'
' Overloaded operators let the physics read as arithmetic rather than as
' bookkeeping over separate X and Y variables.
Public Class Vector2
    Public X As Double
    Public Y As Double

    Public Sub Initialize(Optional ByVal startX As Double = 0, Optional ByVal startY As Double = 0)
        X = startX
        Y = startY
    End Sub

    Public Shared Operator +(ByVal left As Vector2, ByVal right As Vector2) As Vector2
        Return New Vector2 With { .X = left.X + right.X, .Y = left.Y + right.Y }
    End Operator

    Public Shared Operator -(ByVal left As Vector2, ByVal right As Vector2) As Vector2
        Return New Vector2 With { .X = left.X - right.X, .Y = left.Y - right.Y }
    End Operator

    Public Shared Operator *(ByVal value As Vector2, ByVal factor As Double) As Vector2
        Return New Vector2 With { .X = value.X * factor, .Y = value.Y * factor }
    End Operator

    Public Function WithX(ByVal newX As Double) As Vector2
        Return New Vector2 With { .X = newX, .Y = Y }
    End Function

    Public Function WithY(ByVal newY As Double) As Vector2
        Return New Vector2 With { .X = X, .Y = newY }
    End Function

    Public Function Describe() As String
        Return $"({X:0.0}, {Y:0.0})"
    End Function
End Class

' An axis-aligned box, used both for layout and for collision.
Public Class Bounds
    Public Position As Vector2
    Public Size As Vector2

    Public Sub Initialize(ByVal x As Double, ByVal y As Double, ByVal w As Double, ByVal h As Double)
        Set Position = New Vector2 With { .X = x, .Y = y }
        Set Size = New Vector2 With { .X = w, .Y = h }
    End Sub

    Public Property Left As Double
        Get
            Return Position.X
        End Get
    End Property

    Public Property Top As Double
        Get
            Return Position.Y
        End Get
    End Property

    Public Property Right As Double
        Get
            Return Position.X + Size.X
        End Get
    End Property

    Public Property Bottom As Double
        Get
            Return Position.Y + Size.Y
        End Get
    End Property

    Public Property CenterX As Double
        Get
            Return Position.X + Size.X / 2
        End Get
    End Property

    ' Reports whether two boxes overlap.
    Public Function Overlaps(ByVal other As Bounds) As Boolean
        If Right <= other.Left Or Left >= other.Right Then
            Return False
        End If
        If Bottom <= other.Top Or Top >= other.Bottom Then
            Return False
        End If
        Return True
    End Function
End Class

' Packs a colour into a single value, so palettes can be held in one array.
'
' The channels are laid out the way the renderer wants them read back, which is
' what the shift operators below express.
Public Function PackColor(ByVal red As Long, ByVal green As Long, ByVal blue As Long) As Long
    Return (red << 16) Or (green << 8) Or blue
End Function

Public Function RedOf(ByVal packed As Long) As Long
    Return (packed >> 16) And 255
End Function

Public Function GreenOf(ByVal packed As Long) As Long
    Return (packed >> 8) And 255
End Function

Public Function BlueOf(ByVal packed As Long) As Long
    Return packed And 255
End Function
