Imports Geometry

' Anything the renderer can draw.
'
' The interface keeps drawing independent of what a thing *is*: the game loop
' walks one collection and asks each member where it is and what colour it
' should be, without knowing whether it is a paddle, a ball, or a brick.
Public Interface IDrawable
    Function Box() As Bounds
    Function Color() As Long
    Function IsAlive() As Boolean
End Interface

' Shared state and behaviour for everything on the playfield.
Public Class Entity Implements IDrawable
    Public Area As Bounds
    Public Tint As Long
    Public Alive As Boolean

    Public Sub Initialize()
        Alive = True
        Tint = Geometry.PackColor(255, 255, 255)
    End Sub

    Public Function Box() As Bounds Implements IDrawable.Box
        Return Area
    End Function

    Public Function Color() As Long Implements IDrawable.Color
        Return Tint
    End Function

    Public Function IsAlive() As Boolean Implements IDrawable.IsAlive
        Return Alive
    End Function

    ' Advances the entity by one step. Subclasses that move override this.
    Public Overridable Sub Advance(ByVal seconds As Double)
    End Sub

    Public Overridable Function Describe() As String
        Return $"{NameOf(Entity)} at {Area.Position.Describe()}"
    End Function
End Class

' The player's paddle. Moves horizontally and is clamped to the playfield.
Public Class Paddle Inherits Entity
    Public Speed As Double
    Public Direction As Double
    Public FieldWidth As Double

    Public Overrides Sub Advance(ByVal seconds As Double)
        Dim moved As Double = Area.Position.X + Direction * Speed * seconds

        ' Clamp rather than wrap: a paddle that reappears on the other side
        ' would make the game unplayable.
        If moved < 0 Then
            moved = 0
        ElseIf moved + Area.Size.X > FieldWidth Then
            moved = FieldWidth - Area.Size.X
        End If

        Set Area.Position = Area.Position.WithX(moved)
    End Sub

    Public Overrides Function Describe() As String
        Return $"Paddle at x={Area.Position.X:0} moving {Direction:0}"
    End Function
End Class

' The ball. Carries its own velocity and reports when it falls off the bottom.
Public Class Ball Inherits Entity
    Public Velocity As Vector2
    Public FieldWidth As Double

    Public Overrides Sub Advance(ByVal seconds As Double)
        Set Area.Position = Area.Position + Velocity * seconds

        ' Bounce off the side walls and the ceiling.
        If Area.Left <= 0 Then
            Set Area.Position = Area.Position.WithX(0)
            Velocity.X = Abs(Velocity.X)
        ElseIf Area.Right >= FieldWidth Then
            Set Area.Position = Area.Position.WithX(FieldWidth - Area.Size.X)
            Velocity.X = -Abs(Velocity.X)
        End If

        If Area.Top <= 0 Then
            Set Area.Position = Area.Position.WithY(0)
            Velocity.Y = Abs(Velocity.Y)
        End If
    End Sub

    ' Reflects off a surface, nudging the horizontal direction by where the ball
    ' struck so the player can aim.
    Public Sub BounceOff(ByVal surface As Bounds)
        Velocity.Y = -Abs(Velocity.Y)

        Dim offset As Double = (Area.CenterX - surface.CenterX) / (surface.Size.X / 2)
        Velocity.X = Velocity.X + offset * 120
    End Sub

    Public Overrides Function Describe() As String
        Return $"Ball at {Area.Position.Describe()} heading {Velocity.Describe()}"
    End Function
End Class

' A brick worth points, which announces its own destruction.
Public Class Brick Inherits Entity
    Public Points As Long

    ' Raised when the brick is broken, so scoring lives with the game rather
    ' than inside the brick.
    Public Event Destroyed(ByVal points As Long)

    Public Sub Break()
        If Not Alive Then
            Exit Sub
        End If
        Alive = False
        RaiseEvent Destroyed(Points)
    End Sub

    Public Overrides Function Describe() As String
        Return $"Brick worth {Points} at {Area.Position.Describe()}"
    End Function
End Class
